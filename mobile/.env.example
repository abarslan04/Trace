# Public Worker base URL. Native devices must be able to reach this host.
# For a local phone, use your computer's LAN IP; localhost points at the phone.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# OpenFreeMap provides street maps based on OpenStreetMap, without an API key.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_MAP_DARK_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Development builds only: allow local HTTP connections. Omit in production.
TRACE_ALLOW_LOCAL_HTTP=true
